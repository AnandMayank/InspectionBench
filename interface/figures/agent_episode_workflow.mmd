%% InspectionBench A-episode workflow (technical, annotated) -- generated by g2_harness_figures.py; every node/edge mapped in agent_harness_source_map.csv
flowchart TB
  subgraph sg_hidden["Hidden"]
    w0["1 World sampled from seed (hidden)"]
  end
  subgraph sg_visible["Agent-visible"]
    w2["3 Prompt: system prompt + task + tool NAMES<br/>(no schemas, descriptions or parameter specs)"]
    w3["4 LLM call 1 -> STEP 1 JSON"]
    w13["14 LLM call 2: assistant = STEP 1 (parsed JSON);<br/>user = results JSON + rendered dial image(s)"]
  end
  subgraph sg_harness["Harness steps"]
    w1["2 Executor reset from world; tools masked by regime<br/>FULL 25 / PHYSICAL_ONLY 23 (no read_iot, get_sensor_history) /<br/>DIGITAL_ONLY 22 (no capture_image, read_gauge, open_panel)"]
    w4["5 Parse: strip code fences, greedy {...}, json.loads;<br/>failure -> empty dict + parse_error"]
    w5["6 Requested = dict entries of tool_calls"]
    w6["7 Accept first 8 (requested[:8])"]
    w7["8 Trace REQUESTED"]
    w8["9 Tool name in TOOLSET and offered?"]
    w9["10 Execute: world asset id substituted;<br/>direct Python call to the tool function"]
    w10["11 Result status"]
    w10s["success (V1 51,921)"]
    w11["12 Trace EXECUTED(status); SUCCEEDED; OBSERVATION_DELIVERED<br/>only if success AND observation_id<br/>(delivered = succeeded: V1 51,921)"]
    w12["13 Result dict appended for EVERY executed or rejected call"]
    w14["15 Verdict = step2['verdict']; unparsed -> NONE<br/>(e.g. length-terminated output)"]
    w15["16 Trace DECISION; gold derived; score_episode:<br/>TDA = verdict==gold; GSR = TDA AND ERA AND PROV AND COH AND EAA AND CCR<br/>(no cited ids passed, so COH = ERA)"]
  end
  subgraph sg_confound["Interface confounds / rejected calls"]
    w6x["Calls 9+ silently dropped<br/>no trace event; reconstructed from STEP 1 list<br/>V1 2,443 calls / V2 22"]
    w8x["Rejected, not executed: unknown -> failed;<br/>masked -> unavailable (no EXECUTED event)<br/>V1 1 / V2 0"]
    w10f["failed: nested perception-API error (V1 1,892)<br/>or other error/exception (V1 0)"]
    w10u["failed: environment has no qualifying observation<br/>for this asset/modality (V1 8,281)<br/>(status 'unavailable' never occurs for executed calls)"]
    c1["CONFOUND: names-only interface; arguments ignored for asset;<br/>single acquisition round; silent 8-call cap"]
  end
  subgraph sg_leak["Leakage surfaces (from prior audits)"]
    l1["LEAK: scenario id (encodes cell) in inspection_id<br/>V1 5,757 / V2 719 episodes"]
    l2["LEAK: history_mean (IoT-derived) via get_work_order,<br/>also in PHYSICAL_ONLY (2,644 PHYSICAL_ONLY episodes, V1+V2)"]
    l3["LEAK: MIMII '/abnormal/' path in read_acoustic payload (V1 623)"]
    l4["CONTRADICTION: safety_gate_check reports no work order<br/>while get_work_order shows one (V1 1,694)"]
    l5["LEAK: read_gauge gauge_path file-path string (V1 1,966)"]
    l6["INDIRECT EXPOSURE: capture_image dial drawn at the<br/>noise-free physical_value (numeric gauge_value not returned)"]
  end
  w0 --> w1
  w1 --> w2
  w2 --> w3
  w3 --> w4
  w4 --> w5
  w5 --> w6
  w5 -.->|beyond 8| w6x
  w6 -->|per accepted call| w7
  w7 --> w8
  w8 -.->|no| w8x
  w8 -->|yes| w9
  w9 --> w10
  w10 --> w10s
  w10 -.-> w10f
  w10 -.-> w10u
  w10s --> w11
  w10f -.->|EXECUTED only| w11
  w10u -.->|EXECUTED only| w11
  w11 --> w12
  w8x -.->|result shown| w12
  w12 -->|after loop| w13
  w13 --> w14
  w14 --> w15
  c1 -.- w2
  l1 -.- w12
  l2 -.- w12
  l3 -.- w12
  l4 -.- w12
  l5 -.- w12
  l6 -.- w13
  classDef hidden fill:#eef2f7,stroke:#4a5a70,color:#111
  class w0 hidden
  classDef visible fill:#eaf6ee,stroke:#2f6b45,color:#111
  class w2,w3,w13 visible
  classDef harness fill:#ffffff,stroke:#555555,color:#111
  class w1,w4,w5,w6,w7,w8,w9,w10,w10s,w11,w12,w14,w15 harness
  classDef leak fill:#fdecec,stroke:#b42318,color:#111
  class l1,l2,l3,l4,l5,l6 leak
  classDef confound fill:#fff6e0,stroke:#9a6700,color:#111
  class w6x,w8x,w10f,w10u,c1 confound
