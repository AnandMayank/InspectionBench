// InspectionBench agent harness (paper-facing) -- generated by g2_harness_figures.py
digraph G {
  rankdir=TB; newrank=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  subgraph cluster_hidden { label="HIDDEN from the agent: world, gold, tool implementations"; style=dashed; color="#999999";
    gen [label="World compiler\nsample_world(seed, cell, asset)", fillcolor="#eef2f7", color="#4a5a70"];
    world [label="Hidden world state\nphysical_value, iot_value, history_mean,\ntechnician_present, active_work_order", fillcolor="#eef2f7", color="#4a5a70"];
    gold [label="Gold action (P0 derive_gold)\ncomputed by the runner after the episode;\nnever shown to the agent", fillcolor="#eef2f7", color="#4a5a70"];
    impl [label="Tool implementations (FastMCP-decorated functions,\ndocstrings, typed signatures)\nNOT agent-visible", fillcolor="#eef2f7", color="#4a5a70"];
  }
  subgraph cluster_visible { label="AGENT-VISIBLE"; style=dashed; color="#999999";
    prompt [label="Agent-visible input\nsystem prompt + task: asset, gauge range, operating band,\nregime-masked tool NAMES only;\ngeneric envelopes: STEP 1 tool_calls / STEP 2 verdict JSON", fillcolor="#eaf6ee", color="#2f6b45"];
    llm [label="LLM agent\nexactly two chat calls (temperature 0)", fillcolor="#eaf6ee", color="#2f6b45"];
    results [label="Tool results JSON shown to the agent\n(every status: success / failed / unavailable;\nobservation_id + payload when successful)", fillcolor="#eaf6ee", color="#2f6b45"];
    verdict [label="Final verdict JSON\n(STEP 2 envelope)", fillcolor="#eaf6ee", color="#2f6b45"];
  }
  subgraph cluster_harness { label="HARNESS (executor, environment, trace, evaluator)"; style=dashed; color="#999999";
    executor [label="Executor (CouchDBExecutor)\nfirst 8 calls only; tool-name and mask checks;\nworld asset id substituted for arguments", fillcolor="#ffffff", color="#555555"];
    funcs [label="Direct in-process Python calls to the robot tool functions\n(no MCP client/server connection)", fillcolor="#ffffff", color="#555555"];
    env [label="Simulated environment\n(profile written from the hidden world)", fillcolor="#ffffff", color="#555555"];
    gauge [label="read_gauge: noisy NUMERIC reading\nvalue + N(0, 1.5% of span)", fillcolor="#ffffff", color="#555555"];
    trace [label="Execution trace\nappend-only (application level), hash-chained", fillcolor="#ffffff", color="#555555"];
    scorer [label="Execution-based evaluator\nTDA, GSR (metric_contract); VEA (V2 validator)", fillcolor="#ffffff", color="#555555"];
  }
  subgraph cluster_leak { label="Indirect exposure path"; style=dashed; color="#999999";
    dial [label="capture_image: synthetic dial rendered at the\nnoise-free physical_value (image part)", fillcolor="#fdecec", color="#b42318"];
  }
  gen -> world [label="samples"];
  world -> gold [label="derive_gold (hidden)"];
  world -> env [label="reset_from_world"];
  world -> prompt [label="asset + envelope only (render_question)"];
  prompt -> llm [label="call 1"];
  llm -> executor [label="STEP 1 tool_calls"];
  executor -> funcs [label="dispatch"];
  impl -> funcs [label="implementation only", style=dashed];
  funcs -> env [label="read hidden profile"];
  env -> gauge [label="true value + noise"];
  env -> dial [label="true value, no noise", style=dashed, color="#b42318"];
  gauge -> results [label="numeric payload"];
  dial -> results [label="image part (indirect exposure)", style=dashed, color="#b42318"];
  executor -> results [label="all results (any status)"];
  executor -> trace [label="REQUESTED / EXECUTED / SUCCEEDED / OBSERVATION_DELIVERED"];
  results -> llm [label="call 2 (STEP 2)"];
  llm -> verdict [label="parsed"];
  verdict -> trace [label="DECISION"];
  trace -> scorer [label="trace"];
  gold -> scorer [label="gold"];
  verdict -> scorer [label="verdict (no cited ids)"];
}
