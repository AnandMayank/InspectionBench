%% InspectionBench agent harness (paper-facing) -- generated by g2_harness_figures.py; every node/edge mapped in agent_harness_source_map.csv
flowchart TB
  subgraph sg_hidden["HIDDEN from the agent: world, gold, tool implementations"]
    gen["World compiler<br/>sample_world(seed, cell, asset)"]
    world["Hidden world state<br/>physical_value, iot_value, history_mean,<br/>technician_present, active_work_order"]
    gold["Gold action (P0 derive_gold)<br/>computed by the runner after the episode;<br/>never shown to the agent"]
    impl["Tool implementations (FastMCP-decorated functions,<br/>docstrings, typed signatures)<br/>NOT agent-visible"]
  end
  subgraph sg_visible["AGENT-VISIBLE"]
    prompt["Agent-visible input<br/>system prompt + task: asset, gauge range, operating band,<br/>regime-masked tool NAMES only;<br/>generic envelopes: STEP 1 tool_calls / STEP 2 verdict JSON"]
    llm["LLM agent<br/>exactly two chat calls (temperature 0)"]
    results["Tool results JSON shown to the agent<br/>(every status: success / failed / unavailable;<br/>observation_id + payload when successful)"]
    verdict["Final verdict JSON<br/>(STEP 2 envelope)"]
  end
  subgraph sg_harness["HARNESS (executor, environment, trace, evaluator)"]
    executor["Executor (CouchDBExecutor)<br/>first 8 calls only; tool-name and mask checks;<br/>world asset id substituted for arguments"]
    funcs["Direct in-process Python calls to the robot tool functions<br/>(no MCP client/server connection)"]
    env["Simulated environment<br/>(profile written from the hidden world)"]
    gauge["read_gauge: noisy NUMERIC reading<br/>value + N(0, 1.5% of span)"]
    trace["Execution trace<br/>append-only (application level), hash-chained"]
    scorer["Execution-based evaluator<br/>TDA, GSR (metric_contract); VEA (V2 validator)"]
  end
  subgraph sg_leak["Indirect exposure path"]
    dial["capture_image: synthetic dial rendered at the<br/>noise-free physical_value (image part)"]
  end
  gen -->|samples| world
  world -->|derive_gold (hidden)| gold
  world -->|reset_from_world| env
  world -->|asset + envelope only (render_question)| prompt
  prompt -->|call 1| llm
  llm -->|STEP 1 tool_calls| executor
  executor -->|dispatch| funcs
  impl -.->|implementation only| funcs
  funcs -->|read hidden profile| env
  env -->|true value + noise| gauge
  env -.->|true value, no noise| dial
  gauge -->|numeric payload| results
  dial -.->|image part (indirect exposure)| results
  executor -->|all results (any status)| results
  executor -->|REQUESTED / EXECUTED / SUCCEEDED / OBSERVATION_DELIVERED| trace
  results -->|call 2 (STEP 2)| llm
  llm -->|parsed| verdict
  verdict -->|DECISION| trace
  trace -->|trace| scorer
  gold -->|gold| scorer
  verdict -->|verdict (no cited ids)| scorer
  classDef hidden fill:#eef2f7,stroke:#4a5a70,color:#111
  class gen,world,gold,impl hidden
  classDef visible fill:#eaf6ee,stroke:#2f6b45,color:#111
  class prompt,llm,results,verdict visible
  classDef harness fill:#ffffff,stroke:#555555,color:#111
  class executor,funcs,env,gauge,trace,scorer harness
  classDef leak fill:#fdecec,stroke:#b42318,color:#111
  class dial leak
  classDef confound fill:#fff6e0,stroke:#9a6700,color:#111
