// InspectionBench A-episode workflow (technical, annotated) -- generated by g2_harness_figures.py
digraph G {
  rankdir=TB; newrank=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  subgraph cluster_hidden { label="Hidden"; style=dashed; color="#999999";
    w0 [label="1 World sampled from seed (hidden)", fillcolor="#eef2f7", color="#4a5a70"];
  }
  subgraph cluster_visible { label="Agent-visible"; style=dashed; color="#999999";
    w2 [label="3 Prompt: system prompt + task + tool NAMES\n(no schemas, descriptions or parameter specs)", fillcolor="#eaf6ee", color="#2f6b45"];
    w3 [label="4 LLM call 1 -> STEP 1 JSON", fillcolor="#eaf6ee", color="#2f6b45"];
    w13 [label="14 LLM call 2: assistant = STEP 1 (parsed JSON);\nuser = results JSON + rendered dial image(s)", fillcolor="#eaf6ee", color="#2f6b45"];
  }
  subgraph cluster_harness { label="Harness steps"; style=dashed; color="#999999";
    w1 [label="2 Executor reset from world; tools masked by regime\nFULL 25 / PHYSICAL_ONLY 23 (no read_iot, get_sensor_history) /\nDIGITAL_ONLY 22 (no capture_image, read_gauge, open_panel)", fillcolor="#ffffff", color="#555555"];
    w4 [label="5 Parse: strip code fences, greedy {...}, json.loads;\nfailure -> empty dict + parse_error", fillcolor="#ffffff", color="#555555"];
    w5 [label="6 Requested = dict entries of tool_calls", fillcolor="#ffffff", color="#555555"];
    w6 [label="7 Accept first 8 (requested[:8])", fillcolor="#ffffff", color="#555555"];
    w7 [label="8 Trace REQUESTED", fillcolor="#ffffff", color="#555555"];
    w8 [label="9 Tool name in TOOLSET and offered?", fillcolor="#ffffff", color="#555555"];
    w9 [label="10 Execute: world asset id substituted;\ndirect Python call to the tool function", fillcolor="#ffffff", color="#555555"];
    w10 [label="11 Result status", fillcolor="#ffffff", color="#555555"];
    w10s [label="success (V1 51,921)", fillcolor="#ffffff", color="#555555"];
    w11 [label="12 Trace EXECUTED(status); SUCCEEDED; OBSERVATION_DELIVERED\nonly if success AND observation_id\n(delivered = succeeded: V1 51,921)", fillcolor="#ffffff", color="#555555"];
    w12 [label="13 Result dict appended for EVERY executed or rejected call", fillcolor="#ffffff", color="#555555"];
    w14 [label="15 Verdict = step2['verdict']; unparsed -> NONE\n(e.g. length-terminated output)", fillcolor="#ffffff", color="#555555"];
    w15 [label="16 Trace DECISION; gold derived; score_episode:\nTDA = verdict==gold; GSR = TDA AND ERA AND PROV AND COH AND EAA AND CCR\n(no cited ids passed, so COH = ERA)", fillcolor="#ffffff", color="#555555"];
  }
  subgraph cluster_confound { label="Interface confounds / rejected calls"; style=dashed; color="#999999";
    w6x [label="Calls 9+ silently dropped\nno trace event; reconstructed from STEP 1 list\nV1 2,443 calls / V2 22", fillcolor="#fff6e0", color="#9a6700"];
    w8x [label="Rejected, not executed: unknown -> failed;\nmasked -> unavailable (no EXECUTED event)\nV1 1 / V2 0", fillcolor="#fff6e0", color="#9a6700"];
    w10f [label="failed: nested perception-API error (V1 1,892)\nor other error/exception (V1 0)", fillcolor="#fff6e0", color="#9a6700"];
    w10u [label="failed: environment has no qualifying observation\nfor this asset/modality (V1 8,281)\n(status 'unavailable' never occurs for executed calls)", fillcolor="#fff6e0", color="#9a6700"];
    c1 [label="CONFOUND: names-only interface; arguments ignored for asset;\nsingle acquisition round; silent 8-call cap", fillcolor="#fff6e0", color="#9a6700"];
  }
  subgraph cluster_leak { label="Leakage surfaces (from prior audits)"; style=dashed; color="#999999";
    l1 [label="LEAK: scenario id (encodes cell) in inspection_id\nV1 5,757 / V2 719 episodes", fillcolor="#fdecec", color="#b42318"];
    l2 [label="LEAK: history_mean (IoT-derived) via get_work_order,\nalso in PHYSICAL_ONLY (2,644 PHYSICAL_ONLY episodes, V1+V2)", fillcolor="#fdecec", color="#b42318"];
    l3 [label="LEAK: MIMII '/abnormal/' path in read_acoustic payload (V1 623)", fillcolor="#fdecec", color="#b42318"];
    l4 [label="CONTRADICTION: safety_gate_check reports no work order\nwhile get_work_order shows one (V1 1,694)", fillcolor="#fdecec", color="#b42318"];
    l5 [label="LEAK: read_gauge gauge_path file-path string (V1 1,966)", fillcolor="#fdecec", color="#b42318"];
    l6 [label="INDIRECT EXPOSURE: capture_image dial drawn at the\nnoise-free physical_value (numeric gauge_value not returned)", fillcolor="#fdecec", color="#b42318"];
  }
  w0 -> w1;
  w1 -> w2;
  w2 -> w3;
  w3 -> w4;
  w4 -> w5;
  w5 -> w6;
  w5 -> w6x [label="beyond 8", style=dashed];
  w6 -> w7 [label="per accepted call"];
  w7 -> w8;
  w8 -> w8x [label="no", style=dashed];
  w8 -> w9 [label="yes"];
  w9 -> w10;
  w10 -> w10s;
  w10 -> w10f [style=dashed];
  w10 -> w10u [style=dashed];
  w10s -> w11;
  w10f -> w11 [label="EXECUTED only", style=dashed];
  w10u -> w11 [label="EXECUTED only", style=dashed];
  w11 -> w12;
  w8x -> w12 [label="result shown", style=dashed];
  w12 -> w13 [label="after loop"];
  w13 -> w14;
  w14 -> w15;
  c1 -> w2 [style=dotted, arrowhead=none, color="#9a6700"];
  l1 -> w12 [style=dotted, arrowhead=none, color="#9a6700"];
  l2 -> w12 [style=dotted, arrowhead=none, color="#9a6700"];
  l3 -> w12 [style=dotted, arrowhead=none, color="#9a6700"];
  l4 -> w12 [style=dotted, arrowhead=none, color="#9a6700"];
  l5 -> w12 [style=dotted, arrowhead=none, color="#9a6700"];
  l6 -> w13 [style=dotted, arrowhead=none, color="#9a6700"];
}
